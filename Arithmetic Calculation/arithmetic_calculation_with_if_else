#include <stdio.h>

int main() {
    int a, b;
    char operator;
    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);
    printf("Enter an operator (+, -, *, /): ");
    scanf(" %c", &operator);
    
    if (operator == '+') {
        printf("Sum: %d\n", a + b);
    } else if (operator == '-') {
        printf("Difference: %d\n", a - b);
    } else if (operator == '*') {
        printf("Product: %d\n", a * b);
    } else if (operator == '/') {
        if (b != 0) {
            printf("Quotient: %d\n", a / b);
        } else {
            printf("Error: Division by zero is not allowed.\n");
        }
    } else {
        printf("Invalid operator.\n");
    }
}
